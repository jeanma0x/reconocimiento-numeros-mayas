# ---- Datos e imágenes (NO versionar binarios pesados) ----
# Se ignora el contenido, pero se conservan las carpetas vacías (.gitkeep) y los
# README: así al clonar ya queda lista la estructura de captura de data/raw/real/.
# El orden importa: git no puede re-incluir un archivo si su carpeta está excluida,
# por eso las dos líneas que re-incluyen directorios van antes que las de archivos.
data/raw/**
data/processed/**
!data/raw/**/
!data/processed/**/
!data/**/.gitkeep
!data/**/README.md
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/**/*.webp
data/**/*.zip

# ---- Artefactos de entrenamiento ----
ml/runs/
ml/outputs/
*.pt
*.pth
*.ckpt
# El .onnx final SÍ se versiona, vive en web/public/models/
!web/public/models/*.onnx

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / Next.js ----
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo

# ---- Entorno y secretos ----
.env
.env*.local
!.env.example

# ---- Sistema operativo / editores ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
