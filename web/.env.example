# Neon · cadena de conexión pooled. NUNCA con prefijo NEXT_PUBLIC_
DATABASE_URL="postgresql://usuario:clave@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob, para imágenes que el usuario autorice donar al dataset
BLOB_READ_WRITE_TOKEN=""

# Id de la corrida que produjo el .onnx en producción. Se muestra en la interfaz.
NEXT_PUBLIC_MODELO_VERSION="runs/001"
